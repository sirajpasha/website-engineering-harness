{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/claude-hook.js\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/claude-hook.js\""
          }
        ]
      }
    ]
  }
}

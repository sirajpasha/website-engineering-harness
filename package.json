{
  "name": "website-engineering-harness",
  "version": "2.1.0",
  "description": "Give any AI coding agent a website team: 16 specialist roles, 13 evidence-based quality gates, real Playwright QA at 6 viewports, axe accessibility, monotonic ratchets and guard hooks. Claude Code plugin, Gemini extension, MCP server, and installers for Cursor, Windsurf, Copilot and Codex.",
  "author": {
    "name": "Siraj",
    "url": "https://github.com/sirajpasha"
  },
  "license": "MIT",
  "homepage": "https://github.com/sirajpasha/website-engineering-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sirajpasha/website-engineering-harness.git"
  },
  "bugs": {
    "url": "https://github.com/sirajpasha/website-engineering-harness/issues"
  },
  "keywords": [
    "ai-agent",
    "claude-code",
    "claude-code-plugin",
    "mcp",
    "model-context-protocol",
    "gemini-cli",
    "codex",
    "cursor",
    "windsurf",
    "copilot",
    "playwright",
    "axe-core",
    "accessibility",
    "quality-gates",
    "tdd",
    "website",
    "frontend",
    "design-system"
  ],
  "engines": {
    "node": ">=20.13"
  },
  "type": "module",
  "main": "scripts/website-engineering-harness-cli.js",
  "bin": {
    "website-engineering-harness": "./scripts/website-engineering-harness-cli.js",
    "website-harness": "./scripts/website-engineering-harness-cli.js"
  },
  "files": [
    "scripts/",
    "agents/",
    "commands/",
    "skills/",
    "standards/",
    "templates/",
    "workflows/",
    "integrations/",
    "schema/",
    "plugin/",
    ".claude-plugin/",
    ".claude/",
    "examples/sample-website/",
    "mcp.json",
    "gemini-extension.json",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "NOTICE.md",
    "LICENSE",
    "VERSION",
    "README.md",
    "docs/"
  ],
  "scripts": {
    "website-engineering-harness": "node scripts/website-engineering-harness-cli.js",
    "harness": "node scripts/website-engineering-harness-cli.js",
    "audit": "node scripts/environment-audit/audit-environment.js",
    "validate": "node scripts/agent-validation/validate-agents.js",
    "validate:contracts": "node scripts/agent-validation/validate-contracts.js",
    "validate:skills": "node scripts/skill-validation/validate-skills.js",
    "validate:mcp": "node scripts/mcp-validation/validate-mcp.js",
    "validate:trace": "node scripts/traceability/verify-traceability.js",
    "validate:all": "node scripts/website-engineering-harness-cli.js validate",
    "ratchet": "node scripts/ratchets/check-ratchet.js",
    "install-hooks": "node scripts/hooks/install-git-hooks.js",
    "tdd:verify": "node scripts/tdd/verify-tdd.js",
    "pr-respond": "node scripts/ci/pr-respond.js",
    "gate": "node scripts/quality-gates/check-gates.js",
    "gates": "node scripts/quality-gates/check-gates.js --all",
    "test": "node --test tests/**/*.test.js examples/sample-website/tests/**/*.test.js",
    "test:browser": "node scripts/browser-validation/validate-browser.js",
    "audit:security": "node scripts/website-engineering-harness-cli.js audit:security",
    "audit:perf": "node scripts/website-engineering-harness-cli.js audit:perf",
    "evals": "node scripts/evals/run-evals.js",
    "agents:sync": "node scripts/agent-validation/sync-claude-agents.js",
    "validate:subagents": "node scripts/agent-validation/sync-claude-agents.js --check",
    "build:plugin": "node scripts/plugin/build-plugin.js",
    "check:plugin": "node scripts/plugin/build-plugin.js --check",
    "mcp": "node scripts/mcp-server/server.js",
    "install-tool": "node scripts/install/install.js",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "axe-core": "^4.14.0"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}

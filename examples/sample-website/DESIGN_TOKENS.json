{
  "color": {
    "background": "#0b0c10",
    "surface": "#12151c",
    "surfaceElevated": "#1a1f2b",
    "border": "rgba(255, 255, 255, 0.08)",
    "borderStrong": "rgba(255, 255, 255, 0.16)",
    "textPrimary": "#f0f2f5",
    "textSecondary": "#9aa3b2",
    "textMuted": "#8791a6",
    "accent": "#45a29e",
